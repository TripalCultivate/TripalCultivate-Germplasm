<?php

/**
 * @file
 * Contains all hook implementations for this module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function trpcultivate_germplasm_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Provides the module overview in the help tab.
    case 'help.page.trpcultivate_germplasm':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';

      $output .= '<p>' . t('This module provides specialized Tripal fields and importers for germplasm.') . '</p>';

      return $output;

    default:
  }
}

/**
 * Import ontologies and insert terms needed by this module.
 *
 * Expected but not required to be run by a Tripal Job.
 */
function trpcultivate_germplasm_install_terms() {

  // Insert our terms.
  $config_id = 'trpcultivate_germ_terms';
  $terms_setup = \Drupal::service('tripal_chado.terms_init');
  $terms_setup->installTerms($config_id);

  $drupal_connection = \Drupal::database();

  $ontologies = [];
  $ontologies[] = [
    'name' => 'Multi-Crop Passport Ontology',
    'path' => '{trpcultivate_germplasm}/ontologies/mcpd_v2.1_151215.obo',
  ];
  $ontologies[] = [
    'name' => 'TripalCultivate Germplasm Ontology',
    'path' => '{trpcultivate_germplasm}/ontologies/TripalCultivateGermplasmOntology.v1.obo',
  ];

  // Iterate through each ontology and install them with the OBO Importer.
  foreach ($ontologies as $ontology) {

    // Insert the obo record if it's not already there.
    $query = $drupal_connection->upsert('tripal_cv_obo')
      ->fields(['name', 'path'])
      ->key('name');
    $query->values($ontology);
    $query->execute();

    // Get obo id.
    $obo_id = $drupal_connection->select('tripal_cv_obo', 'tco')
      ->fields('tco', ['obo_id'])
      ->condition('name', $ontology['name'])
      ->execute()
      ->fetchField();

    if (!$obo_id) {
      \Drupal::logger('trpcultivate_germplasm')->notice("Importing " . $ontology['name']);
      $importer_manager = \Drupal::service('tripal.importer');
      $obo_importer = $importer_manager->createInstance('chado_obo_loader');
      $obo_importer->createImportJob(['obo_id' => $obo_id]);
      $obo_importer->run();
      $obo_importer->postRun();
    }
    else {
      \Drupal::logger('trpcultivate_germplasm')->error("Tripal Cultivate Germplasm could not find an obo record for ontology " . $ontology['name']);
    }
  }
}
